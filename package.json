{
  "name": "iqvoc_skosxl",
  "version": "2.11.3",
  "description": "SKOS-XL extension for iQvoc vocabulary management system built on the Semantic Web",
  "main": "app/javascript/manifest.js",
  "files": [
    "app/assets/**/*",
    "app/javascript/**/*"
  ],
  "scripts": {
    "build": "esbuild app/javascript/*.* --bundle --sourcemap --format=esm --outdir=app/assets/builds --public-path=/assets",
    "build:css": "sass ./app/assets/stylesheets/application.scss:./app/assets/builds/application.css --no-source-map --load-path=node_modules"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/innoq/iqvoc_skosxl.git"
  },
  "author": "",
  "license": "Apache License 2.0",
  "bugs": {
    "url": "https://github.com/innoq/iqvoc_skosxl/issues"
  },
  "homepage": "https://github.com/innoq/iqvoc_skosxl#readme",
  "devDependencies": {
    "esbuild": "^0.24.0",
    "sass": "^1.80.0"
  },
  "dependencies": {
    "es6-promise": "^4.2.8",
    "iqvoc": "github:innoq/iqvoc#bootstrap5"
  }
}
